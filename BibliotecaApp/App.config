<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Ajuste "Server" según su instalación:
        localhost              -> instancia por defecto
        .\SQLEXPRESS           -> SQL Server Express
        (localdb)\MSSQLLocalDB -> LocalDB de Visual Studio
      Para autenticación SQL use: User Id=sa;Password=SuClave;
    -->
    <add name="BibliotecaDB"
         connectionString="Server=localhost;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=10;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
