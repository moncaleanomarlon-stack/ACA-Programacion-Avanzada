digraph ER {
  rankdir=LR; fontname="Helvetica"; node [shape=plaintext fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=10];
  Autores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#212b36"><FONT COLOR="white"><B>Autores</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> AutorID : INT</TD></TR><TR><TD ALIGN="LEFT">Nombre : VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Apellido : VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Nacionalidad : VARCHAR(50)</TD></TR></TABLE>>];
  Editoriales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#212b36"><FONT COLOR="white"><B>Editoriales</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> EditorialID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B> Nombre : VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">Telefono : VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B> Email : VARCHAR(100)</TD></TR></TABLE>>];
  Libros [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0078d4"><FONT COLOR="white"><B>Libros</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> LibroID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B> ISBN : VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">Titulo : VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> AutorID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> EditorialID : INT</TD></TR><TR><TD ALIGN="LEFT">AnioPublicacion : INT</TD></TR><TR><TD ALIGN="LEFT">Stock : INT (disponibles)</TD></TR></TABLE>>];
  Usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#212b36"><FONT COLOR="white"><B>Usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> UsuarioID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B> Documento : VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">Nombre : VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Apellido : VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Telefono : VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B> Email : VARCHAR(100)</TD></TR></TABLE>>];
  Prestamos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0078d4"><FONT COLOR="white"><B>Prestamos</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> PrestamoID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> UsuarioID : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> LibroID : INT</TD></TR><TR><TD ALIGN="LEFT">FechaPrestamo : DATETIME</TD></TR><TR><TD ALIGN="LEFT">FechaDevolucion : DATETIME NULL</TD></TR><TR><TD ALIGN="LEFT">Estado : VARCHAR(20)</TD></TR></TABLE>>];
  Autores -> Libros [label="1 : N  escribe" arrowhead=crow];
  Editoriales -> Libros [label="1 : N  publica" arrowhead=crow];
  Libros -> Prestamos [label="1 : N  se presta en" arrowhead=crow];
  Usuarios -> Prestamos [label="1 : N  solicita" arrowhead=crow];
}
