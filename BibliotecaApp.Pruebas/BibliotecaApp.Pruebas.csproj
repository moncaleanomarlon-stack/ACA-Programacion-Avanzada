<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas automáticas de las reglas de validación y de las entidades.
       No requieren SQL Server. Ejecutar:  dotnet run --project BibliotecaApp.Pruebas -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>BibliotecaApp.Pruebas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BibliotecaApp\Entidades\*.cs" />
    <Compile Include="..\BibliotecaApp\LogicaNegocio\Validador.cs" />
  </ItemGroup>

</Project>
