<Project Sdk="Microsoft.NET.Sdk">

  <!-- Herramienta auxiliar (no forma parte de la aplicación): genera DOCUMENTACION.pdf
       a partir de DOCUMENTACION.md con número de página en el pie.
       Requiere Microsoft Edge (incluido en Windows). Ver herramientas/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

</Project>
